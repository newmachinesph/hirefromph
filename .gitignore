# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/tool state (never committed)
.firecrawl
.impeccable
.claude-flow
.claude
.superpowers/

# test and browser artifacts
/test-results/
/playwright-report/
/blob-report/
/.lighthouseci/

# generated photoreal sources (regenerable, large)
design/images/raw/

# stale Next build dirs left by concurrent builds
.next-stale-*/

# Social drafts (posts and graphics) are not part of the site
social/
