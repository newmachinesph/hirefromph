      { "title": "Sheets: auto-timestamp on edit", "lang": "Apps Script", "code": "function onEdit(e){\n  const s = e.source.getActiveSheet();\n  const r = e.range;\n  s.getRange(r.getRow(), 10).setValue(new Date());\n}" },
      { "title": "Sheets: clean & trim text", "lang": "Formula", "code": "=TRIM(CLEAN(PROPER(A2)))" },
      { "title": "Gmail: canned follow-up shortcut", "lang": "Text", "code": "Hi [Name], floating this back up, still keen to help with [task]. Any questions I can answer?" },
      { "title": "Sheets: days until due", "lang": "Formula", "code": "=IF(B2=\"\",\"\",B2-TODAY())" }
